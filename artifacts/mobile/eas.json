{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_REVENUECAT_TEST_API_KEY": "COLOQUE_AQUI_SUA_CHAVE_TEST",
        "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "COLOQUE_AQUI_SUA_CHAVE_IOS",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY": "COLOQUE_AQUI_SUA_CHAVE_ANDROID"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_REVENUECAT_TEST_API_KEY": "COLOQUE_AQUI_SUA_CHAVE_TEST",
        "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "COLOQUE_AQUI_SUA_CHAVE_IOS",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY": "COLOQUE_AQUI_SUA_CHAVE_ANDROID"
      }
    }
  }
}
