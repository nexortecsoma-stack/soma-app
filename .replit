modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["revenuecat:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 18115
externalPort = 3000

[[ports]]
localPort = 18116
externalPort = 3002

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
REVENUECAT_PROJECT_ID = "proj34f50942"
REVENUECAT_TEST_STORE_APP_ID = "app934a04a791"
REVENUECAT_APPLE_APP_STORE_APP_ID = "app63ad5c5775"
REVENUECAT_GOOGLE_PLAY_STORE_APP_ID = "appd83b06ada2"
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY = "test_BRhekZmiBsEJWSaOReJWqbgywNP"
